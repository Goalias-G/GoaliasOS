<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.goalias.system.mapper.LifeRecordMapper">


    <select id="queryRecordCountByCategoryId" resultType="com.goalias.system.domain.vo.LifeRecordCountVo">
        select category_id,count(1) as count from life_record where category_id in
        <foreach item="item" collection="categoryIds"
                 separator="," open="(" close=")">
            #{item}
        </foreach>
        group by category_id
    </select>
</mapper>
