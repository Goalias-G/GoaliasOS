<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.goalias.system.mapper.SysScheduledTaskLogMapper">

    <resultMap id="BaseResultMap" type="com.goalias.system.domain.SysScheduledTaskLog">
        <id property="id" column="id"/>
        <result property="taskId" column="task_id"/>
        <result property="taskName" column="task_name"/>
        <result property="taskType" column="task_type"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="durationMs" column="duration_ms"/>
        <result property="status" column="status"/>
        <result property="errorMessage" column="error_message"/>
        <result property="resultMessage" column="result_message"/>
        <result property="source" column="source"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectLogPage" resultType="com.goalias.system.domain.vo.SysScheduledTaskLogVo">
        SELECT id, task_id, task_name, task_type, start_time, end_time, duration_ms,
               status, error_message, result_message, source, create_time
        FROM sys_scheduled_task_log
        <where>
            <if test="taskId != null">
                AND task_id = #{taskId}
            </if>
            <if test="taskName != null and taskName != ''">
                AND task_name LIKE CONCAT('%', #{taskName}, '%')
            </if>
            <if test="taskType != null and taskType != ''">
                AND task_type = #{taskType}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="source != null and source != ''">
                AND source = #{source}
            </if>
            <if test="beginTime != null and beginTime != ''">
                AND start_time &gt;= #{beginTime}
            </if>
            <if test="endTime != null and endTime != ''">
                AND start_time &lt;= #{endTime}
            </if>
        </where>
        ORDER BY start_time DESC
    </select>

</mapper>
